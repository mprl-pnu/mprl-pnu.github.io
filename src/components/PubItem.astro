---
import { site, hasImage } from '../lib/data';
import { type Lang, img, t } from '../lib/i18n';

interface Props {
  pub: {
    title: string;
    authors: string;
    venue: string;
    details?: string;
    year: number;
    type: string;
    link?: string;
    video?: string;
    image?: string;
    note?: string;
  };
  lang: Lang;
  thumb?: boolean;
}

const { pub, lang, thumb = false } = Astro.props;
const authors = pub.authors.split(/,\s*/);
const isPI = (name: string) => site.highlight_authors.includes(name.replace(/\*+$/, '').trim());
const filterType = pub.type === 'preprint' || pub.type === 'thesis' ? 'other' : pub.type;
const thumbSrc = thumb
  ? hasImage(pub.image)
    ? img(pub.image!)
    : pub.video
      ? `https://i.ytimg.com/vi/${pub.video}/mqdefault.jpg`
      : undefined
  : undefined;
---

<article class:list={['pub', { 'has-thumb': thumbSrc }]} data-type={filterType}>
  {
    thumbSrc && (
      <div class="thumb">
        <img src={thumbSrc} alt="" loading="lazy" decoding="async" />
      </div>
    )
  }
  <div>
    <h3 class="title">
      {pub.link ? <a href={pub.link} target="_blank" rel="noopener">{pub.title}</a> : pub.title}
    </h3>
    <p class="authors">
      {
        authors.map((a, i) => (
          <>
            {isPI(a) ? <strong>{a}</strong> : a}
            {i < authors.length - 1 && ', '}
          </>
        ))
      }
    </p>
    <p class="venue">
      <em>{pub.venue}</em>{pub.details && <>, {pub.details}</>} ({pub.year})
      {pub.note && <span class="note"> · {pub.note}</span>}
    </p>
    <div class="actions">
      {pub.type !== 'journal' && <span class="chip">{t(lang, `pubs.${pub.type}` as any)}</span>}
      {pub.link && <a class="chip chip--accent" href={pub.link} target="_blank" rel="noopener">{pub.type === 'patent' ? t(lang, 'pubs.view') : t(lang, 'pubs.paper')} ↗</a>}
      {pub.video && <a class="chip chip--accent" href={`https://youtu.be/${pub.video}`} target="_blank" rel="noopener">{t(lang, 'pubs.video')} ▶</a>}
    </div>
  </div>
</article>

<style>
  .pub {
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
  }

  .has-thumb {
    display: grid;
    grid-template-columns: 132px minmax(0, 1fr);
    gap: 20px;
    align-items: start;
  }

  .thumb {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--bg-soft);
    border: 1px solid var(--line);
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .title {
    font-size: 1.02rem;
    font-weight: 650;
    line-height: 1.45;
    letter-spacing: -0.01em;
  }

  .title a {
    color: var(--ink);
  }

  .title a:hover {
    color: var(--accent);
  }

  .authors {
    margin-top: 4px;
    font-size: 0.925rem;
    color: var(--ink-2);
  }

  .authors strong {
    color: var(--ink);
    font-weight: 700;
  }

  .venue {
    font-size: 0.925rem;
    color: var(--muted);
  }

  .venue em {
    color: var(--ink-2);
    font-style: italic;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 8px;
  }

  .actions:empty {
    display: none;
  }

  .actions a.chip:hover {
    text-decoration: none;
    background: var(--accent);
    color: #fff;
  }

  @media (max-width: 560px) {
    .has-thumb {
      grid-template-columns: 96px minmax(0, 1fr);
      gap: 14px;
    }
  }
</style>
