---
import Base from '../layouts/Base.astro';
import NewsItem from '../components/NewsItem.astro';
import { news, talks, media, NEWS_TAGS } from '../lib/data';
import { type Lang, formatDate, t } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const years = [...new Set(news.map((n) => n.date.slice(0, 4)))];
const tags = NEWS_TAGS.filter((tag) => news.some((n) => n.tag === tag));
---

<Base lang={lang} title={t(lang, 'news.title')} active="news">
  <header class="page-head">
    <div class="container">
      <h1>{t(lang, 'news.title')}</h1>
      <p>{t(lang, 'news.lead')}</p>
    </div>
  </header>

  <section class="section">
    <div class="container">
      <div class="filters" data-filter-group="news-list" hidden>
        <button type="button" data-filter="all" aria-pressed="true">{t(lang, 'pubs.all')}<span class="count">{news.length}</span></button>
        {
          tags.map((tag) => (
            <button type="button" data-filter={tag} aria-pressed="false">
              {t(lang, `tag.${tag}` as any)}
              <span class="count">{news.filter((n) => n.tag === tag).length}</span>
            </button>
          ))
        }
      </div>

      <div id="news-list">
        {
          years.map((y) => (
            <section class="year" data-group id={`y${y}`}>
              <h2>{y}</h2>
              <div>
                {news
                  .filter((n) => n.date.startsWith(y))
                  .map((n) => (
                    <NewsItem item={n} lang={lang} />
                  ))}
              </div>
            </section>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container grid-2">
      <div>
        <div class="section-head"><h2>{t(lang, 'news.talks')}</h2></div>
        <ul class="plain-list">
          {
            talks.map((x) => (
              <li>
                <span class="when">{formatDate(x.date, lang)}</span>
                <div>
                  {x.link ? <a href={x.link} target="_blank" rel="noopener">{x.title}</a> : <span class="ttl">{x.title}</span>}
                  <p class="muted">{x.venue}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <div class="section-head"><h2>{t(lang, 'news.media')}</h2></div>
        <ul class="plain-list">
          {
            media.map((x) => (
              <li>
                <span class="when">{formatDate(x.date, lang)}</span>
                <div>
                  {x.link ? <a href={x.link} target="_blank" rel="noopener">{x.title}</a> : <span class="ttl">{x.title}</span>}
                  <p class="muted">{x.outlet}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  .year {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    gap: 24px;
  }

  .year + .year {
    margin-top: 40px;
  }

  .year h2 {
    position: sticky;
    top: calc(var(--header-h) + 16px);
    align-self: start;
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--line-strong);
  }

  .year :global(.news-item:first-of-type) {
    padding-top: 4px;
  }

  .plain-list {
    list-style: none;
  }

  .plain-list li {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }

  .plain-list a,
  .plain-list .ttl {
    color: var(--ink);
    font-weight: 600;
    line-height: 1.5;
  }

  .plain-list a:hover {
    color: var(--accent);
  }

  .plain-list p {
    font-size: 0.9rem;
    margin-top: 2px;
  }

  .when {
    color: var(--muted);
    font-size: 0.9rem;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 720px) {
    .year {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
    }

    .year h2 {
      position: static;
      color: var(--ink);
      font-size: 1.25rem;
      border-bottom: 2px solid var(--ink);
    }
  }
</style>
