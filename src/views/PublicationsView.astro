---
import Base from '../layouts/Base.astro';
import PubItem from '../components/PubItem.astro';
import { site, publications } from '../lib/data';
import { type Lang, t } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const kind = (type: string) => (type === 'preprint' || type === 'thesis' ? 'other' : type);
const count = (k: string) => publications.filter((p) => k === 'all' || kind(p.type) === k).length;
const filters = (['all', 'journal', 'conference', 'patent', 'other'] as const)
  .map((k) => ({ key: k, label: t(lang, `pubs.${k}`), n: count(k) }))
  .filter((f) => f.n > 0);

const years = [...new Set(publications.map((p) => p.year))];
---

<Base lang={lang} title={t(lang, 'pubs.title')} active="publications">
  <header class="page-head">
    <div class="container">
      <h1>{t(lang, 'pubs.title')}</h1>
      <p>
        {t(lang, 'pubs.lead')}{' '}
        {site.links.scholar && <a href={site.links.scholar} target="_blank" rel="noopener">{t(lang, 'pubs.scholar')} ↗</a>}
      </p>
    </div>
  </header>

  <section class="section">
    <div class="container">
      <div class="filters" data-filter-group="pub-list" hidden>
        {
          filters.map((f, i) => (
            <button type="button" data-filter={f.key} aria-pressed={i === 0 ? 'true' : 'false'}>
              {f.label}
              <span class="count">{f.n}</span>
            </button>
          ))
        }
      </div>

      <div id="pub-list">
        {
          years.map((y) => (
            <section class="year" data-group>
              <h2>{y}</h2>
              <div>
                {publications
                  .filter((p) => p.year === y)
                  .map((p) => (
                    <PubItem pub={p} lang={lang} />
                  ))}
              </div>
            </section>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .year {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    gap: 24px;
    padding-top: 8px;
  }

  .year + .year {
    margin-top: 24px;
  }

  .year h2 {
    position: sticky;
    top: calc(var(--header-h) + 16px);
    align-self: start;
    padding-top: 16px;
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--line-strong);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 720px) {
    .year {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }

    .year h2 {
      position: static;
      color: var(--ink);
      font-size: 1.25rem;
      padding: 0 0 4px;
      border-bottom: 2px solid var(--ink);
    }
  }
</style>
