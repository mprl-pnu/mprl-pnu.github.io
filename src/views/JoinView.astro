---
import Base from '../layouts/Base.astro';
import { site, joinInfo, people, recruitingDeadline } from '../lib/data';
import { type Lang, formatDate, t, tx, txList } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { open, positions } = site.recruiting;
const destinations = [...new Set(people.alumni.map((a) => (a.now ? tx(a.now, lang) : '')).filter(Boolean))];
const subject = encodeURIComponent(lang === 'ko' ? '[MPRL 지원] 이름 / 학년' : '[MPRL application] Name');
const columns = [
  { title: t(lang, 'join.topics'), items: txList(joinInfo.topics, lang) },
  { title: t(lang, 'join.lookingFor'), items: txList(joinInfo.looking_for, lang) },
  { title: t(lang, 'join.youGet'), items: txList(joinInfo.you_get, lang) },
];
---

<Base lang={lang} title={t(lang, 'join.title')} active="join">
  <header class="page-head">
    <div class="container">
      <span class:list={['status', { open }]}>
        <span class="dot" aria-hidden="true"></span>
        {open ? t(lang, 'join.open') : t(lang, 'join.closed')}
      </span>
      <h1>{t(lang, 'join.title')}</h1>
      <p>{tx(joinInfo.intro, lang)}</p>
      {!open && <p class="muted">{t(lang, 'join.closedBody')}</p>}
      <dl class="facts">
        {
          open && positions && (
            <div>
              <dt>{t(lang, 'join.positions')}</dt>
              <dd>{tx(positions, lang)}</dd>
            </div>
          )
        }
        {
          open && recruitingDeadline && (
            <div>
              <dt>{t(lang, 'join.deadline')}</dt>
              <dd>{formatDate(recruitingDeadline, lang)}</dd>
            </div>
          )
        }
        <div>
          <dt>{t(lang, 'contact.email')}</dt>
          <dd><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></dd>
        </div>
      </dl>
    </div>
  </header>

  <section class="section">
    <div class="container cols">
      {
        columns.map((c) => (
          <div class="col">
            <h2>{c.title}</h2>
            <ul class="dot-list">
              {c.items.map((i) => (
                <li>{i}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  {
    destinations.length > 0 && (
      <section class="section section--soft">
        <div class="container">
          <div class="section-head"><h2>{t(lang, 'join.alumni')}</h2></div>
          <ul class="chip-list dest">
            {destinations.map((d) => (
              <li class="chip">{d}</li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="container apply">
      <div>
        <h2>{t(lang, 'join.apply')}</h2>
        <p>{tx(joinInfo.how_to_apply, lang)}</p>
        {joinInfo.closing && <p class="closing">{tx(joinInfo.closing, lang)}</p>}
      </div>
      <a class="btn btn--primary" href={`mailto:${site.contact.email}?subject=${subject}`}>✉ {t(lang, 'join.email')}</a>
    </div>
  </section>
</Base>

<style>
  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 14px;
    padding: 5px 12px;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 700;
    background: var(--bg-soft);
    color: var(--muted);
    border: 1px solid var(--line);
  }

  .status .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--muted);
  }

  .status.open {
    background: #ecfdf3;
    color: #15803d;
    border-color: #bbf7d0;
  }

  .status.open .dot {
    background: #16a34a;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 48px;
    margin: 28px 0 0;
  }

  .facts dt {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .facts dd {
    margin: 2px 0 0;
    font-weight: 600;
    color: var(--ink);
  }

  .cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(24px, 4vw, 48px);
  }

  .col h2 {
    font-size: 1.2rem;
    padding-bottom: 12px;
    margin-bottom: 16px;
    border-bottom: 2px solid var(--ink);
  }

  .dest .chip {
    font-size: 0.925rem;
    padding: 7px 16px;
    background: #fff;
  }

  .apply {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
  }

  .apply h2 {
    font-size: 1.5rem;
    margin-bottom: 8px;
  }

  .apply p {
    max-width: 62ch;
  }

  .closing {
    margin-top: 12px;
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .cols {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
